# Copy this file to ".env" and fill in ONE key. ".env" is git-ignored.
# The key is only used by the summarize_file tool (the cheap-model fallback).

# Option 1: Google Gemini (default model: gemini-2.5-flash)
GEMINI_API_KEY=

# Option 2: Anthropic (default model: claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=

# Optional overrides
# CHEAP_MODEL_PROVIDER=gemini        # or: anthropic (auto-detected from the key you set)
# CHEAP_MODEL=gemini-2.5-flash       # any model your key can use
# CODEBASE_ROOT=/absolute/path/to/repo   # only if the tool folder lives OUTSIDE the repo
# CODEBASE_MAX_FILE_BYTES=1000000
# CODEBASE_EXCLUDE_DIRS=legacy,generated  # extra folder names to skip
