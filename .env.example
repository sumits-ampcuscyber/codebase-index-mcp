# Copy this file to ".env" (git-ignored). Every setting is optional.

# ---- Repo to index (only if this tool folder lives OUTSIDE the repo)
# CODEBASE_ROOT=/absolute/path/to/repo

# ---- Cursor subagent model used by setup_cursor.py (default: grok-4.7)
# Use the exact model id from Cursor's model picker; "inherit" and "fast" also work.
# CURSOR_SUBAGENT_MODEL=grok-4.7

# ---- Cheap model for summarize_file: fill in ONE key (leave both empty to stay fully offline)
# Option 1: Google Gemini (default model: gemini-2.5-flash)
GEMINI_API_KEY=
# Option 2: Anthropic (default model: claude-haiku-4-5; also run: pip install anthropic)
ANTHROPIC_API_KEY=
# CHEAP_MODEL_PROVIDER=gemini        # or anthropic (auto-detected from the key you set)
# CHEAP_MODEL=gemini-2.5-flash       # any model your key can use

# ---- Indexing
# CODEBASE_WATCH_INTERVAL=2          # seconds between background re-scans; 0 = off
# CODEBASE_MAX_FILE_BYTES=1000000
# CODEBASE_EXCLUDE_DIRS=legacy,generated   # extra folder names to skip
# CODEBASE_INDEX_WORKERS=4           # parser processes for big (2,000+ file) runs; 1 = in-process
